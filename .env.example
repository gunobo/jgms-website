# Only needed when actually deploying (see README "4. 서버 배포"). Not used for
# local development — `docker compose up -d --build` works fine without this file.
# Copy to `.env` in the project root: cp .env.example .env

# Real MySQL credentials for the deployed server (defaults are dev-only placeholders)
MYSQL_ROOT_PASSWORD="change-me-root"
MYSQL_PASSWORD="change-me-app-password"

# Public URLs once deployed behind Cloudflare Tunnel
FRONTEND_ORIGIN="https://jgms.imjemin.co.kr"
VITE_API_URL="https://jgms-api.imjemin.co.kr"

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel (Cloudflared type)
# > copy the token from the install command.
CLOUDFLARE_TUNNEL_TOKEN=""
