# Used by `docker compose -f docker-compose.prod.yml` for MySQL credentials and
# CORS. Copy to `.env` in the project root before deploying:
#   cp .env.prod.example .env

MYSQL_ROOT_PASSWORD="change-me-root"
MYSQL_DATABASE="jgms_club"
MYSQL_USER="jgms"
MYSQL_PASSWORD="change-me-app-password"

# Public URL of the site (used to configure backend CORS). If using Cloudflare
# Tunnel with a domain, set this to that domain, e.g. https://club.example.com
PUBLIC_URL="http://localhost:5106"

# Cloudflare Zero Trust > Networks > Tunnels > Create a tunnel (Cloudflared type)
# > copy the token from the install command. Leave blank and remove the
# `cloudflared` service from docker-compose.prod.yml if you don't use a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=""
