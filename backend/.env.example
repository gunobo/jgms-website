# --- Database ---
# NOTE: docker-compose.yml overrides DATABASE_URL with the mysql/MYSQL_* values
# from the root .env, so this line is only used if you run the backend directly
# (uv run ...) without docker-compose. No need to edit it for a normal deploy.
DATABASE_URL="mysql+pymysql://jgms:jgms_dev_pw@localhost:33066/jgms_club"

# --- Sessions ---
# Generate with: openssl rand -hex 32
JWT_SECRET=""
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=10080

# --- Google Sign-In ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=""
# Optional: restrict sign-in to your school's Google Workspace domain (e.g. "jgms.hs.kr")
GOOGLE_WORKSPACE_HD=""

# --- Bootstrap admin(s) ---
# Comma-separated school Google emails auto-promoted to admin on first login
ADMIN_EMAILS="startea0716@gmail.com"

# --- Google Sheets sync ---
# A Google Cloud service account (JSON key) with the Sheets API enabled.
# Share each target spreadsheet with this service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# --- CORS ---
# NOTE: docker-compose.yml overrides this with FRONTEND_ORIGIN from the root
# .env (defaults to localhost:5174 for dev). No need to edit it here.
FRONTEND_ORIGIN="http://localhost:5174"
