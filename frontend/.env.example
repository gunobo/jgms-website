# NOTE: when running via docker-compose, both of these are actually sourced
# from the ROOT .env at build time (VITE_API_URL, VITE_GOOGLE_CLIENT_ID) —
# this file's values are only used if you run `npm run dev`/`vite build`
# directly on the host, without Docker. No need to edit it for a normal deploy.
VITE_API_URL="http://localhost:8001"
VITE_GOOGLE_CLIENT_ID=""
